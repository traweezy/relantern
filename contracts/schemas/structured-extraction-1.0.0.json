{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relantern structured extraction",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      }
    },
    "event_type": {
      "type": "string",
      "enum": [
        "release",
        "security",
        "breaking_change",
        "deprecation",
        "migration",
        "preview",
        "proposal",
        "general",
        "unknown"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["stable", "preview", "release_candidate", "deprecated", "end_of_life", "unknown"]
    },
    "deep_extraction_justified": {
      "type": "boolean"
    },
    "claims": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_type": {
            "type": "string",
            "enum": [
              "release",
              "version",
              "date",
              "breaking_change",
              "deprecation",
              "security",
              "migration_prerequisite",
              "example",
              "compatibility",
              "general"
            ]
          },
          "claim_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "normalized_value": {
            "type": "string",
            "maxLength": 500
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"]
          },
          "material": {
            "type": "boolean"
          },
          "evidence_span_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^span_[0-9]{4}$"
            }
          }
        },
        "required": [
          "claim_type",
          "claim_text",
          "normalized_value",
          "confidence",
          "material",
          "evidence_span_ids"
        ]
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "topic_ids",
    "event_type",
    "lifecycle_state",
    "deep_extraction_justified",
    "claims",
    "uncertainties"
  ]
}
