# Safe local defaults only. Secret values are generated under .local/secrets.
APP_ENV=local
AUTH_ALLOWED_GITHUB_USER_ID=5276132
AUTH_PROVIDER_MODE=fixture
BETTER_AUTH_URL=http://127.0.0.1:3000
INTERNAL_API_URL=http://127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:3000
CLOCK_MODE=system
GIT_SHA=unknown
TEST_NOW=
OWNER_TIMEZONE=America/New_York
SESSION_MAX_AGE_SECONDS=604800

# The local OAuth fixture is browser-facing on 127.0.0.1 and server-facing
# over the private Compose network. Secret values remain in .local/secrets.
LOCAL_OAUTH_AUTHORIZATION_URL=http://127.0.0.1:8090/oauth/authorize
LOCAL_OAUTH_TOKEN_URL=http://fake-source:8090/oauth/token
LOCAL_OAUTH_USERINFO_URL=http://fake-source:8090/oauth/userinfo

# Live provider and delivery fuses stay disabled. Research uses fake-openai.
ALLOW_LIVE_EXTERNAL_APIS=false
ALLOW_LIVE_DELIVERY=false
OPENAI_BACKGROUND_ENABLED=true
OPENAI_DAILY_WEB_SEARCH_LIMIT=100
OPENAI_RESEARCH_ENABLED=true
OPENAI_RESEARCH_MAX_OUTPUT_TOKENS=8192
OPENAI_RESEARCH_MAX_TOOL_CALLS=4
