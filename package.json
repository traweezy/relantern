{
  "name": "relantern",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first personal developer intelligence.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "26.8.1",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "build": "pnpm --filter @relantern/web build",
    "dev": "pnpm --filter @relantern/web dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate": "pnpm --filter @relantern/api-client generate",
    "lint": "biome check .",
    "railway:check": "tsc --project tsconfig.railway.json && vitest run .railway/railway.test.ts",
    "test": "vitest run .railway/railway.test.ts && pnpm --recursive --if-present test",
    "typecheck": "tsc --project tsconfig.railway.json && tsc --project tsconfig.e2e.json && pnpm --recursive --if-present typecheck",
    "demo:build": "pnpm --filter @relantern/web exec next build demo && node scripts/package-public-demo.mjs",
    "demo:test": "node --test scripts/demo-csp.test.mjs deploy/demo/server.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "openapi-typescript": "7.13.0",
    "parse5": "8.0.1",
    "railway": "3.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
